                        "text": "NEW FREE BUSINESS AUDIT\n\nHi there,\n\nA new Free Business Systems Audit has been submitted through the SOLVIA SYSTEMS website.\n\n━━━━━━━━━━━━━━━━━━━━━━\nCLIENT DETAILS\n━━━━━━━━━━━━━━━━━━━━━━\n\nName: {{10.name}}\nBusiness: {{10.business_name}}\nEmail: {{10.email}}\nPhone: {{10.phone}}\nWebsite: {{10.website}}\n\n━━━━━━━━━━━━━━━━━━━━━━\nAUDIT RESPONSES\n━━━━━━━━━━━━━━━━━━━━━━\n\nBusiness Type:\n{{10.business_type}}\n\nWhere enquiries come from:\n{{10.enquiry_source}}\n\nWhat takes the most time:\n{{10.time_consuming_process}}\n\nWhere customer information is stored:\n{{10.customer_information_location}}\n\nWhat happens when someone enquires:\n{{10.enquiry_process}}\n\nWhat they would most like to improve:\n{{10.desired_improvement}}\n\nRepetitive admin per week:\n{{10.admin_time}}\n\n━━━━━━━━━━━━━━━━━━━━━━\nAI BUSINESS AUDIT\n━━━━━━━━━━━━━━━━━━━━━━\n\n{{12.result}}\n━━━━━━━━━━━━━━━━━━━━━\n\nAudit Status: Completed\n\nSubmitted: {{10.submitted_at}}\n\nSOLVIA SYSTEMS\nWe solve what slows your business down.",
